<%- include('partials/header', { title: project.name, email: '' }) %>
<div class="page-head"><div><span class="eyebrow">PROJECT</span><h1><%=project.name%></h1><p><a href="<%=project.base_url%>" target="_blank" rel="noreferrer"><%=project.base_url%></a></p></div><div class="head-actions"><a class="btn secondary" href="/projects/<%=project.id%>/edit">Edit</a><a class="btn secondary" href="/projects/<%=project.id%>/roles/new">＋ Role</a><a class="btn secondary" href="/projects/<%=project.id%>/scenarios/new">＋ Scenario</a><form method="post" action="/projects/<%=project.id%>/run"><button class="btn primary" type="submit">▶ Full QA crawl</button></form></div></div>
<div class="info-strip"><div><span>Default login</span><strong><%=project.login_url&&project.username?'Configured':'No'%></strong></div><div><span>Devices</span><strong><%=viewportProfiles.join(', ')%></strong></div><div><span>Schedule</span><strong><%=project.schedule_enabled?'Every '+project.schedule_interval_minutes+' min':'Manual'%></strong></div></div>
<div class="feature-chip-row"><span class="feature-chip <%=project.enable_visual?'on':''%>">Visual</span><span class="feature-chip <%=project.enable_accessibility?'on':''%>">Accessibility</span><span class="feature-chip <%=project.enable_performance?'on':''%>">Performance</span><span class="feature-chip <%=project.enable_trace?'on':''%>">Trace</span><span class="feature-chip <%=project.enable_video?'on':''%>">Video</span></div>

<div class="section-head"><div><h2>Automation trigger</h2><p>Use this endpoint from GitHub Actions, deployment scripts or another CI system.</p></div><form method="post" action="/projects/<%=project.id%>/regenerate-token" onsubmit="return confirm('Regenerate trigger token? Existing integrations will stop working.')"><button class="btn secondary" type="submit">Regenerate token</button></form></div>
<div class="code-panel"><code>POST /hooks/projects/<%=project.id%>/run/<%=project.trigger_token%></code><small>Optional JSON body for a scenario: <code>{"scenario_id": 123}</code></small></div>

<div class="section-head"><div><h2>Test roles</h2><p>Separate credentials for Admin, Staff, Customer and other permission levels.</p></div><a class="btn secondary" href="/projects/<%=project.id%>/roles/new">＋ Add role</a></div>
<%if(!roles.length){%><div class="empty-state small"><h3>No named roles</h3><p>Add roles when different users see different parts of the system.</p></div><%}else{%><div class="scenario-grid"><%roles.forEach(role=>{ %><article class="scenario-card"><div><span class="eyebrow">ROLE</span><h3><%=role.name%></h3><p><%=role.username||'No username'%></p></div><div class="card-actions"><a class="btn secondary" href="/roles/<%=role.id%>/edit">Edit</a><form method="post" action="/roles/<%=role.id%>/delete" onsubmit="return confirm('Delete this role?')"><button class="btn danger-btn">Delete</button></form></div></article><%})%></div><%}%>

<div class="section-head"><div><h2>Scenarios</h2><p>Reusable browser + API workflows with retries and role-based login.</p></div><a class="btn secondary" href="/projects/<%=project.id%>/scenarios/new">＋ Add scenario</a></div>
<%if(!scenarios.length){%><div class="empty-state small"><h3>No scenarios yet</h3><p>Create login → action → assertion workflows.</p></div><%}else{%><div class="scenario-grid"><%scenarios.forEach(s=>{ %><article class="scenario-card"><div><span class="eyebrow">WORKFLOW</span><h3><%=s.name%></h3><p><%=s.description||'Reusable workflow'%></p><small><%=s.step_count%> steps · <%=s.role_name||'default login'%> · <%=s.retry_count||0%> retries</small></div><div class="card-actions"><form method="post" action="/scenarios/<%=s.id%>/run"><button class="btn primary">▶ Run</button></form><a class="btn secondary" href="/scenarios/<%=s.id%>/edit">Edit</a><form method="post" action="/scenarios/<%=s.id%>/delete" onsubmit="return confirm('Delete this scenario?')"><button class="btn danger-btn">Delete</button></form></div></article><%})%></div><%}%>

<div class="section-head"><div><h2>Test runs</h2><p>Background crawl and scenario history.</p></div></div>
<%if(!runs.length){%><div class="empty-state small"><h3>No test runs yet</h3></div><%}else{%><div class="table-card"><table><thead><tr><th>Run</th><th>Type</th><th>Status</th><th>Views/steps</th><th>Issues</th><th>Clean/pass</th><th>Completed</th><th></th></tr></thead><tbody><%runs.forEach(run=>{ %><tr><td>#<%=run.id%></td><td><span class="category"><%=run.run_type||'crawl'%></span></td><td><span class="status-pill <%=run.status%>"><%=run.status%></span></td><td><%=run.pages_scanned%></td><td><strong class="<%=run.issues_count?'text-danger':'text-success'%>"><%=run.issues_count%></strong></td><td><%=run.clean_pages%></td><td><%=formatDate(run.completed_at)%></td><td><a class="text-link" href="/runs/<%=run.id%>">View report →</a></td></tr><%})%></tbody></table></div><%}%>
<div class="danger-zone"><div><h3>Delete project</h3><p>Removes project, roles, scenarios, history and database records.</p></div><form method="post" action="/projects/<%=project.id%>/delete" onsubmit="return confirm('Delete this project and all history?')"><button class="btn danger-btn">Delete project</button></form></div>
<%- include('partials/footer') %>
