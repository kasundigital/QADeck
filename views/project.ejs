<%- include('partials/header', { title: project.name, email: '' }) %>
<div class="page-head">
  <div><span class="eyebrow">PROJECT</span><h1><%= project.name %></h1><p><a href="<%= project.base_url %>" target="_blank" rel="noreferrer"><%= project.base_url %></a></p></div>
  <div class="head-actions"><a class="btn secondary" href="/projects/<%= project.id %>/edit">Edit</a><form method="post" action="/projects/<%= project.id %>/run"><button class="btn primary" type="submit">▶ Run QA</button></form></div>
</div>

<div class="info-strip"><div><span>Login configured</span><strong><%= project.login_url && project.username ? 'Yes' : 'No' %></strong></div><div><span>Created</span><strong><%= formatDate(project.created_at) %></strong></div><div><span>Safety mode</span><strong>Read-only crawl</strong></div></div>

<div class="section-head"><div><h2>Test runs</h2><p>Latest browser runs for this project.</p></div></div>
<% if (!runs.length) { %><div class="empty-state small"><h3>No test runs yet</h3><p>Start the first run to crawl the website and collect screenshots and issues.</p></div><% } else { %>
<div class="table-card"><table><thead><tr><th>Run</th><th>Status</th><th>Pages</th><th>Issues</th><th>Clean pages</th><th>Completed</th><th></th></tr></thead><tbody>
<% runs.forEach((run) => { %><tr><td>#<%= run.id %></td><td><span class="status-pill <%= run.status %>"><%= run.status %></span></td><td><%= run.pages_scanned %></td><td><strong class="<%= run.issues_count ? 'text-danger' : 'text-success' %>"><%= run.issues_count %></strong></td><td><%= run.clean_pages %></td><td><%= formatDate(run.completed_at) %></td><td><a class="text-link" href="/runs/<%= run.id %>">View report →</a></td></tr><% }) %>
</tbody></table></div>
<% } %>
<div class="danger-zone"><div><h3>Delete project</h3><p>Removes the project, its test history and database records.</p></div><form method="post" action="/projects/<%= project.id %>/delete" onsubmit="return confirm('Delete this project and all test history?')"><button class="btn danger-btn" type="submit">Delete project</button></form></div>
<%- include('partials/footer') %>
