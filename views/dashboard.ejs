<%- include('partials/header', { title: 'Projects', email }) %>
<div class="page-head">
  <div><span class="eyebrow">OVERVIEW</span><h1>Projects</h1><p>Run browser-based QA checks across all your web systems from one place.</p></div>
  <a class="btn primary" href="/projects/new">＋ Add Project</a>
</div>

<div class="stats-grid">
  <div class="stat-card"><span>Projects</span><strong><%= totals.projects %></strong></div>
  <div class="stat-card"><span>Total runs</span><strong><%= totals.runs %></strong></div>
  <div class="stat-card"><span>Issues found</span><strong><%= totals.issues %></strong></div>
  <div class="stat-card"><span>Running now</span><strong><%= totals.running %></strong></div>
</div>

<% if (!projects.length) { %>
  <div class="empty-state"><div class="empty-icon">✓</div><h2>Add your first project</h2><p>QADeck will crawl the site in a real Chromium browser, capture screenshots and report HTTP, JavaScript, network, asset and layout issues.</p><a class="btn primary" href="/projects/new">Add Project</a></div>
<% } else { %>
  <div class="project-grid">
  <% projects.forEach((project) => { %>
    <article class="project-card">
      <div class="project-top"><div><h2><a href="/projects/<%= project.id %>"><%= project.name %></a></h2><p><%= project.base_url %></p></div><span class="status-pill <%= project.last_status || 'idle' %>"><%= project.last_status || 'Not tested' %></span></div>
      <div class="project-metrics"><div><strong><%= project.last_pages ?? '—' %></strong><span>Pages</span></div><div><strong><%= project.last_issues ?? '—' %></strong><span>Issues</span></div><div><strong><%= project.last_completed ? formatDate(project.last_completed) : 'Never' %></strong><span>Last run</span></div></div>
      <div class="card-actions"><form method="post" action="/projects/<%= project.id %>/run"><button class="btn primary" type="submit">▶ Run QA</button></form><a class="btn secondary" href="/projects/<%= project.id %>">View project</a></div>
    </article>
  <% }) %>
  </div>
<% } %>
<%- include('partials/footer') %>
