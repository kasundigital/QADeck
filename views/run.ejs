<%- include('partials/header', { title: 'Run #' + run.id, email: '' }) %>
<div class="page-head"><div><span class="eyebrow">TEST REPORT</span><h1><%=run.project_name%> · Run #<%=run.id%></h1><p><%=run.base_url%></p></div><div class="head-actions"><button class="btn primary pdf-export-btn" type="button" onclick="exportPdfReport()">⇩ Export PDF</button><a class="btn secondary" href="/projects/<%=run.project_id%>">← Project</a><%if(run.trace_path){%><a class="btn secondary" href="<%=run.trace_path%>" target="_blank">Trace</a><%}%><%if(run.video_path){%><a class="btn secondary" href="<%=run.video_path%>" target="_blank">Video</a><%}%></div></div>

<section class="pdf-report-header print-only">
  <div class="pdf-brand-row"><div class="pdf-brand-mark">Q</div><div><strong>QADeck</strong><span>Web Quality Assurance Report</span></div><div class="pdf-report-badge"><%=String(run.status||'unknown').toUpperCase()%></div></div>
  <div class="pdf-title-row"><div><h1><%=run.project_name%></h1><p><%=run.base_url%></p></div><div class="pdf-run-number">Run #<%=run.id%></div></div>
  <div class="pdf-meta-grid">
    <div><span>Run type</span><strong><%=run.run_type||'crawl'%></strong></div>
    <div><span>Status</span><strong><%=run.status%></strong></div>
    <div><span>Started</span><strong><%=formatDate(run.started_at)%></strong></div>
    <div><span>Completed</span><strong><%=formatDate(run.completed_at)%></strong></div>
    <div><span>Views / steps</span><strong><%=run.pages_scanned%></strong></div>
    <div><span>Issues</span><strong><%=run.issues_count%></strong></div>
    <div><span>Clean / passed</span><strong><%=run.clean_pages%></strong></div>
    <div><span>Generated</span><strong><%=new Date().toLocaleString()%></strong></div>
  </div>
</section>

<%if(run.status==='queued'||run.status==='running'){%><div class="running-banner"><span class="spinner"></span><div><strong>QA test is <%=run.status%> in the background…</strong><p>You can close QADeck. The worker continues independently.</p><%if(run.current_url){%><p><strong>Now:</strong> <%=run.current_url%></p><%}%></div></div><script>setTimeout(()=>location.reload(),2500)</script><%}%>
<%if(run.status==='failed'){%><div class="alert danger"><strong>Run failed:</strong> <%=run.error_message%></div><%}%>
<div class="stats-grid report-stats"><div class="stat-card"><span>Status</span><strong class="capitalize"><%=run.status%></strong></div><div class="stat-card"><span>Views / steps</span><strong><%=run.pages_scanned%></strong></div><div class="stat-card"><span>Issues</span><strong class="<%=run.issues_count?'text-danger':'text-success'%>"><%=run.issues_count%></strong></div><div class="stat-card"><span>Clean / passed</span><strong><%=run.clean_pages%></strong></div></div>

<%if(run.ai_summary){%><div class="section-head"><div><h2>AI summary</h2><p>Generated by your configured OpenAI-compatible endpoint.</p></div></div><div class="ai-summary"><pre><%=run.ai_summary%></pre></div><%}%>

<%if(scenario){%><div class="artifact-strip"><div><strong>Scenario: <%=scenario.name%></strong><span><%=scenario.role_name?'Role: '+scenario.role_name:'Default project login'%> · retries: <%=scenario.retry_count||0%></span></div></div><%}%>

<%if(stepResults.length){%><div class="section-head"><div><h2>Scenario steps</h2><p>Pass, flaky, fail and skipped evidence by viewport.</p></div></div><div class="table-card pdf-table-card"><table><thead><tr><th>Device</th><th>Step</th><th>Action</th><th>Status</th><th>Attempts</th><th>Message</th><th>Evidence</th></tr></thead><tbody><%stepResults.forEach(s=>{ %><tr><td><%=s.viewport%></td><td><%=s.position%></td><td><%=s.action%></td><td><span class="status-pill <%=s.status==='pass'?'completed':s.status==='flaky'?'queued':s.status==='fail'?'failed':''%>"><%=s.status%></span></td><td><%=s.attempts||0%></td><td><%=s.message||''%></td><td><%if(s.screenshot_path){%><a class="text-link screen-only" href="<%=s.screenshot_path%>" target="_blank">Screenshot</a><img class="print-only pdf-step-thumb" src="<%=s.screenshot_path%>" alt="Step evidence"><%}else{%>—<%}%></td></tr><%})%></tbody></table></div><%}%>

<%if(issues.length){%><div class="section-head"><div><h2>Issues</h2><p>HTTP, JavaScript, network, accessibility, performance, flaky and visual findings.</p></div></div><div class="issues-list"><%issues.forEach(issue=>{ %><article class="issue-card"><div class="issue-bar"><span class="severity <%=issueClass(issue.severity)%>"><%=issue.severity%></span><span class="category"><%=issue.category%></span><%if(issue.viewport){%><span class="category"><%=issue.viewport%></span><%}%></div><div class="issue-body"><div class="issue-copy"><h3><%=issue.message%></h3><%if(issue.page_url){%><p class="issue-url"><%=issue.page_url%></p><%}%><%if(issue.details){%><pre><%=issue.details%></pre><%}%></div><%if(issue.screenshot_path){%><a href="<%=issue.screenshot_path%>" target="_blank" class="thumb"><img src="<%=issue.screenshot_path%>" alt="Issue evidence"></a><%}%></div></article><%})%></div><%}else if(run.status==='completed'){%><div class="success-panel"><span>✓</span><div><h2>No reportable issues</h2><p>The configured QA checks completed cleanly.</p></div></div><%}%>

<%if(pages.length){%><div class="section-head"><div><h2>Page & device timeline</h2><p>Visual, accessibility and performance evidence for each tested page.</p></div></div><div class="page-grid enhanced-pages pdf-page-grid"><%pages.forEach(page=>{ let perf={};try{perf=page.performance_json?JSON.parse(page.performance_json):{};}catch{} %><article class="page-card qa-page-card"><a href="<%=page.screenshot_path%>" target="_blank" class="page-shot"><img src="<%=page.screenshot_path%>" alt="Page screenshot"></a><div class="page-card-body"><div class="page-card-head"><strong><%=page.title||'Untitled'%></strong><span class="viewport-badge"><%=page.viewport%></span></div><span><%=page.status_code||'—'%> · <%=page.duration_ms%> ms</span><small title="<%=page.url%>"><%=page.url%></small><div class="mini-metrics"><span>A11y <strong><%=page.accessibility_count||0%></strong></span><span>Visual <strong><%=page.visual_change_pct==null?'—':Number(page.visual_change_pct).toFixed(2)+'%'%></strong></span><span>Perf <strong><%=page.performance_score==null?'—':page.performance_score+'/100'%></strong></span><%if(perf.lcp){%><span>LCP <strong><%=perf.lcp%>ms</strong></span><%}%><%if(perf.cls!=null){%><span>CLS <strong><%=perf.cls%></strong></span><%}%></div><%if(page.baseline_path){%><div class="visual-actions screen-only"><a href="<%=page.baseline_path%>" target="_blank">Baseline</a><a href="<%=page.screenshot_path%>" target="_blank">Current</a><%if(page.diff_path){%><a href="<%=page.diff_path%>" target="_blank">Diff</a><%}%></div><%if(Number(page.visual_change_pct||0)>0){%><form class="screen-only" method="post" action="/pages/<%=page.id%>/approve-baseline"><button class="btn secondary small-btn">Approve baseline</button></form><%}%><%}%></div></article><%})%></div><%}%>

<%if(notifications.length){%><div class="section-head"><div><h2>Notifications</h2><p>Delivery log for this run.</p></div></div><div class="table-card pdf-table-card"><table><thead><tr><th>Channel</th><th>Status</th><th>Message</th><th>Time</th></tr></thead><tbody><%notifications.forEach(n=>{ %><tr><td><%=n.channel%></td><td><%=n.status%></td><td><%=n.message||'—'%></td><td><%=formatDate(n.created_at)%></td></tr><%})%></tbody></table></div><%}%>

<div class="print-only pdf-report-footer"><span>QADeck · Web Quality Assurance Report</span><span>Run #<%=run.id%> · <%=run.project_name%></span></div>
<script>
async function exportPdfReport(){
  const originalTitle=document.title;
  const pdfTitle=<%- JSON.stringify('QADeck-' + String(run.project_name || 'Project').replace(/[^a-zA-Z0-9_-]+/g,'-') + '-Run-' + run.id) %>;
  document.title=pdfTitle;
  const pending=[...document.images].filter(img=>!img.complete).map(img=>new Promise(resolve=>{img.addEventListener('load',resolve,{once:true});img.addEventListener('error',resolve,{once:true});}));
  if(pending.length)await Promise.all(pending);
  await new Promise(resolve=>setTimeout(resolve,100));
  const restore=()=>{document.title=originalTitle;window.removeEventListener('afterprint',restore);};
  window.addEventListener('afterprint',restore);
  window.print();
  setTimeout(()=>{if(document.title===pdfTitle)document.title=originalTitle;},5000);
}
</script>
<%- include('partials/footer') %>
